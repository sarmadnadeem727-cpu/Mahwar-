# Mahwar (محور) Environment Variables Example
# Copy this to .env.local and populate with your API keys.

# Google Gemini API Key (for AI Research Memos & Global AI Command Search)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Marketaux API Key (for GCC Market Intelligence News Feed)
# Get a free key at: https://www.marketaux.com/
MARKETAUX_API_KEY=

# Finlight API Key (for Arabic Financial News Intelligence)
# Get a free key at: https://finlight.me/
FINLIGHT_API_KEY=
