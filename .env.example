# Mahwar — environment variables (copy to .env.local)

# Optional: premium GCC news feed. Without it the wire falls back to a public RSS feed.
MARKETAUX_API_KEY=

# Public URL used in metadata / Open Graph.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: hero background footage. Leave empty to disable the video layer entirely.
NEXT_PUBLIC_HERO_VIDEO=/bg-video.mp4


# ---------------------------------------------------------------------------
# Google sign-in (Auth.js v5). Leave all three empty to run in guest mode.
# 1. https://console.cloud.google.com → APIs & Services → Credentials
#    → Create OAuth client ID (Web application)
# 2. Authorised redirect URI:  <your-url>/api/auth/callback/google
#    (e.g. http://localhost:3000/api/auth/callback/google)
# 3. Generate AUTH_SECRET with:  npx auth secret
# ---------------------------------------------------------------------------
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: only allow these Google Workspace domains (comma separated).
AUTH_ALLOWED_DOMAINS=

# Only needed on non-Vercel hosts or behind a proxy; Vercel infers it.
AUTH_URL=http://localhost:3000
