# Mahwar — environment variables (copy to .env.local)

# Optional: premium GCC news feed. Without it the wire falls back to a public RSS feed.
MARKETAUX_API_KEY=

# Public URL used in metadata / Open Graph.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: hero background footage. Leave empty to disable the video layer entirely.
NEXT_PUBLIC_HERO_VIDEO=/bg-video.mp4
