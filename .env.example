# Mahwar — environment variables (copy to .env.local)

# Optional: premium GCC news feed. Without it the wire falls back to a public RSS feed.
MARKETAUX_API_KEY=

# Stock screener — live quotes.
# Default (no key needed): TradingView's public scanner — free, price +
# fundamentals for all seven GCC exchanges. Undocumented endpoint, best-effort.
# MARKET_DATA_PROVIDER=tradingview   # force it even when a key below is set
# MARKET_DATA_PROVIDER=none          # disable live data (reference snapshot only)
#
# Keyed providers (used automatically when set):
#
# Recommended: Twelve Data (https://twelvedata.com). One REST + WebSocket API
# that covers Tadawul (XSAU), DFM, ADX, QSE, Boursa Kuwait, Bahrain and Muscat
# by MIC code. Free plan for development; GCC intraday needs a paid tier.
TWELVEDATA_API_KEY=
# Alternative: EODHD (https://eodhd.com) — strong fundamentals, Tadawul via .SR.
EODHD_API_KEY=

# Public URL used in metadata / Open Graph.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shown on /privacy as the address for data requests. Required before going live.
NEXT_PUBLIC_PRIVACY_CONTACT=
